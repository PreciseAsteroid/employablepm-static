---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    // content-layer ids include the .md extension; strip it for clean URLs
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');
// meta_title already carries the site suffix when present; otherwise compose it
const pageTitle = post.data.meta_title ?? `${post.data.title} | Employable PM`;
const pageDescription = post.data.meta_description ?? post.data.excerpt;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <article>
    <p class="kicker">
      {fmt(post.data.date)}
      {post.data.source === 'linkedin' && <span class="badge-linkedin">LinkedIn</span>}
    </p>
    <h1>{post.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
    {
      post.data.linkedin_url && (
        <p class="origin-note">
          Originally posted on LinkedIn —{' '}
          <a href={post.data.linkedin_url} rel="noopener">read it there</a>
        </p>
      )
    }
  </article>
</BaseLayout>
