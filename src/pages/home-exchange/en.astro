<script>
(function(){
  var track=function(name,params){try{if(typeof window.gtag==='function')window.gtag('event',name,params)}catch(e){}};
  var gal=document.getElementById('gallery');
  var slides=Array.prototype.slice.call(gal.querySelectorAll('.slide'));
  var counter=document.getElementById('gal-counter');
  var rtl=(document.documentElement.dir==='rtl');
  function current(){
    var r=gal.getBoundingClientRect();
    var anchor=rtl?r.right:r.left;
    var best=0,bd=Infinity;
    slides.forEach(function(s,i){
      var sr=s.getBoundingClientRect();
      var edge=rtl?sr.right:sr.left;
      var d=Math.abs(edge-anchor);
      if(d<bd){bd=d;best=i}
    });
    return best;
  }
  function update(){counter.textContent=(current()+1)+' / '+slides.length}
  function go(d){
    var i=Math.max(0,Math.min(slides.length-1,current()+d));
    slides[i].scrollIntoView({behavior:'smooth',inline:'start',block:'nearest'});
  }
  document.getElementById('gal-next').addEventListener('click',function(){track('gallery_nav',{direction:'next',page_path:location.pathname});go(1)});
  document.getElementById('gal-prev').addEventListener('click',function(){track('gallery_nav',{direction:'prev',page_path:location.pathname});go(-1)});
  var st;
  gal.addEventListener('scroll',function(){if(st)cancelAnimationFrame(st);st=requestAnimationFrame(update)});
  gal.addEventListener('keydown',function(e){
    if(e.key==='ArrowRight'){e.preventDefault();go(rtl?-1:1)}
    if(e.key==='ArrowLeft'){e.preventDefault();go(rtl?1:-1)}
  });
  update();
  var lb=document.getElementById('lightbox');
  var lbi=lb.querySelector('img');
  slides.forEach(function(s,idx){
    s.addEventListener('click',function(){
      var im=s.querySelector('img');
      lbi.src=im.src;lbi.alt=im.alt;
      lb.classList.add('open');
      track('gallery_zoom',{photo_index:idx+1,page_path:location.pathname});
    });
  });
  function close(){lb.classList.remove('open');lbi.src=''}
  lb.addEventListener('click',close);
  document.addEventListener('keydown',function(e){if(e.key==='Escape')close()});
})();
</script>
<script>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var el = document.documentElement;
          var next = el.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          el.setAttribute('data-theme', next);
          try { localStorage.setItem('epm-theme', next); } catch (e) {}
        });
      })();
    </script><script>
      // GA4 click events: any link with data-ga-event fires it (no URLs or contact values in params).
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[data-ga-event]') : null;
        if (!a || typeof window.gtag !== 'function') return;
        try {
          var params = { page_path: location.pathname };
          var label = a.getAttribute('data-ga-label');
          if (label) params.content_label = label;
          window.gtag('event', a.getAttribute('data-ga-event'), params);
        } catch (err) {}
      });
    </script></body>
