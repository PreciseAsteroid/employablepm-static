---
import '../styles/global.css';

interface Props {
  /** Full <title> content, composed by the page (meta_title or title). */
  title: string;
  description?: string;
  /** Set for unlisted pages (one-pager): keep out of search engines. */
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
const siteName = 'Employable PM';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E7B0GZGWFV"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E7B0GZGWFV');
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <a class="site-name" href="/">Employable&nbsp;PM<span class="dot">.</span></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/">Posts</a>
          <a href="/about/">About</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>&copy; Amir Baruch</span>
        <a href="/rss.xml">rss.xml</a>
      </footer>
    </div>
  </body>
</html>
